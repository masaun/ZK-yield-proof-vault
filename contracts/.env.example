# Mantle Network Configuration
MANTLE_MAINNET_RPC_URL=https://rpc.mantle.xyz
MANTLE_TESTNET_RPC_URL=https://rpc.testnet.mantle.xyz

# Deployer Configuration
PRIVATE_KEY=your_deployer_private_key_here

# Oracle/Relayer Configuration (generated from scripts/generateRelayerKeys.ts)
ORACLE_ADDRESS=your_oracle_address_here
ORACLE_PRIVATE_KEY=your_oracle_private_key_here

# Deployed Contract Addresses - Mantle Mainnet
# (Fill these after running deployment script)
MAINNET_REGISTRATION_SMT_REPLICATOR_ADDRESS=
MAINNET_ZK_KYC_RARIMO_ADDRESS=

# Deployed Contract Addresses - Mantle Testnet
# (Fill these after running deployment script)
TESTNET_REGISTRATION_SMT_REPLICATOR_ADDRESS=
TESTNET_ZK_KYC_RARIMO_ADDRESS=

# Etherscan API Key (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Rarimo Configuration
RARIMO_SOURCE_SMT=0x479F84502Db545FA8d2275372E0582425204A879
