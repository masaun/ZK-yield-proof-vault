# Etherscan API Key (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Mantle Network Configuration
MANTLE_MAINNET_RPC_URL=https://rpc.mantle.xyz
MANTLE_TESTNET_RPC_URL=https://rpc.sepolia.mantle.xyz

# Deployer Configuration
PRIVATE_KEY=your_deployer_private_key_here

# Deployed Contract Addresses - Mantle Mainnet
MAINNET_HONK_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_YIELD_PROOF_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_YIELD_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed Contract Addresses - Mantle Testnet
TESTNET_HONK_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_YIELD_PROOF_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_YIELD_VAULT_ADDRESS=0x0000000000000000000000000000000000000000



